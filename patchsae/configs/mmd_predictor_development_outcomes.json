      "pets": "oxford_pets"
    },
    "command": "python tasks/eval_matrix.py --datasets pathmnist pets --vit_types lora --sae_conditions none gsae --dataset_registry configs/rebuttal_datasets.json --gsae_path data/sae_weight/base/out.pt --seed 42 --batch_size 8 --max_images 1500 --val_split 0.15 --out_dir out/rebuttal/mmd_predictor_dev_ready"
  },
