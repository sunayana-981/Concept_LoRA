      "lora"
    ],
    "sae_conditions": [
      "none",
      "gsae"
    ],
    "evaluation_seed": 42,
    "max_images": 1500,
    "val_split": 0.15,
    "note": "Use the same max_images, split, prompts/class names, checkpoint format, and evaluation seed for both cells and all domains. Do not mix the older 225-image matrix with new larger evaluations in a confirmatory fit; rerun the full 15-domain cohort under one protocol."
  },
  "existing_paired_outcomes_in_current_matrix": [
    "eurosat",
    "dtd",
    "caltech101",
    "cub2002011",
    "ucf101"
  ],
